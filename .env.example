# Postgres (hrb_rag_ingestion schema)
POSTGRES_DB_HOST=localhost
POSTGRES_DB_PORT=5432
POSTGRES_DB_NAME=
POSTGRES_DB_USER=postgres
POSTGRES_DB_PASSWORD=

# Embeddings
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBED_MODEL=text-embedding-3-small

# Vector store (same two providers hrb_chatbot_service supports)
CHROMA_DB_MODE=persistent
CHROMA_DB_HOST=localhost
CHROMA_DB_PORT=8000
CHROMA_DB_PERSIST_DIR=data/chroma_db
CHROMA_DB_ALLOW_RESET=false
PINECONE_API_KEY=
PINECONE_INDEX_NAME=hrb-chatbot-kb
PINECONE_CLOUD=aws
PINECONE_ENVIRONMENT=us-east-1
PINECONE_METRIC=cosine
PINECONE_DIMENSION=1536

# S3 upload + async (Pinecone-only) indexing path
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_UPLOAD_BUCKET=
S3_PRESIGNED_URL_EXPIRY_SECONDS=300
SQS_INGEST_QUEUE_URL=

# Observability
LOG_FORMAT=json
LANGSMITH_API_KEY=
LANGSMITH_ENABLED=false
LANGSMITH_PROJECT=rag_ingestion_service
